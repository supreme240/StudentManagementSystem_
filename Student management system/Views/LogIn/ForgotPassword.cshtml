@model StudentManagement.domain.Domain.ForgotPassword

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Student Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f4f6f9;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 100%;
                max-width: 380px;
                background: #ffffff;
                border-radius: 16px;
                padding: 36px 32px;
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            }

            .form-label {
                font-size: 11.5px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #6c757d;
                margin-bottom: 6px;
            }

            .form-control {
                border-radius: 8px;
                font-size: 14px;
                padding: 10px 14px;
            }

                .form-control:focus {
                    border-color: #212529;
                    box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.08);
                }

            .btn-reset {
                background: #212529;
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: 11px;
                font-size: 15px;
                font-weight: 500;
                width: 100%;
                transition: opacity .15s;
                margin-top: 4px;
            }

                .btn-reset:hover {
                    opacity: .82;
                    color: #fff;
                }

            .error-alert {
                background: #fff2f2;
                border: 1px solid #f5c6c6;
                border-radius: 8px;
                color: #b94a4a;
                padding: 10px 14px;
                font-size: 13px;
                margin-top: 14px;
            }
    </style>
</head>
<body>

    <div class="login-card text-center">

        <!-- Header -->
        <h5 class="fw-bold mb-1">Student Management System</h5>
        <p class="text-muted small mb-4">Reset Your Password</p>

        <form action="/LogIn/ForgotPassword" method="post" class="text-start">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" id="Email" name="Email" value="@Model.Email"
                       class="form-control" placeholder="Enter registered email" />
                <span class="text-danger small">@Html.ValidationMessage("Email")</span>
            </div>

            <!-- Phone Number -->
            <div class="mb-3">
                <label for="PhoneNumber" class="form-label">Phone Number</label>
                <input type="text" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber"
                       class="form-control" placeholder="Enter registered phone number" />
                <span class="text-danger small">@Html.ValidationMessage("PhoneNumber")</span>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label for="Password" class="form-label">New Password</label>
                <input type="password" id="Password" name="Password"
                       class="form-control" placeholder="Enter new password" />
                <span class="text-danger small">@Html.ValidationMessage("Password")</span>
            </div>

            <!-- Confirm Password -->
            <!-- Reset Button -->
            <button type="submit" class="btn-reset">Reset Password</button>

            <!-- Error Message -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-alert">
                    ⚠️ @ViewBag.ErrorMessage
                </div>
            }

        </form>

        <div class="text-center mt-4 small text-muted">
            Remembered it?
            <a href="/LogIn/LogIn" class="text-dark fw-semibold">Back to Login</a>
        </div>

    </div>

</body>
</html>
