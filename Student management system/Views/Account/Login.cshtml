@model StudentManagement.domain.Domain.LogIn

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Student Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f4f6f9;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 100%;
                max-width: 380px;
                background: #ffffff;
                border-radius: 16px;
                padding: 36px 32px;
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            }

            .brand-icon {
                width: 52px;
                height: 52px;
                background: #e8c97e;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                margin: 0 auto 14px;
            }

            .form-label {
                font-size: 11.5px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #6c757d;
                margin-bottom: 6px;
            }

            .form-control {
                border-radius: 8px;
                font-size: 14px;
                padding: 10px 14px;
            }

                .form-control:focus {
                    border-color: #212529;
                    box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.08);
                }

            .btn-login {
                background: #212529;
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: 11px;
                font-size: 15px;
                font-weight: 500;
                width: 100%;
                transition: opacity .15s;
                margin-top: 4px;
            }

                .btn-login:hover {
                    opacity: .82;
                    color: #fff;
                }

            .error-alert {
                background: #fff2f2;
                border: 1px solid #f5c6c6;
                border-radius: 8px;
                color: #b94a4a;
                padding: 10px 14px;
                font-size: 13px;
                margin-top: 14px;
            }
    </style>
</head>
<body>

    <div class="login-card text-center">

        <!-- Brand -->
        <div>
            <h5 class="fw-bold mb-1">Student Management System</h5>
            <p class="text-muted small mb-4">Log In</p>
        </div>

       
        <form asp-controller="Account" asp-action="Login" method="post" class="text-start">
            @Html.AntiForgeryToken()

            <!-- Username or Email -->
            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label">
                    Username or Email
                </label>
                <input asp-for="UserNameOrEmail"
                       type="text"
                       class="form-control"
                       placeholder="Enter username or email" />
                <span asp-validation-for="UserNameOrEmail"
                      class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <input asp-for="Password"
                           type="password"
                           id="passwordInput"
                           class="form-control"
                           placeholder="Enter password" />

                </div>
                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn-login">Login</button>

            <!-- Error Message below button -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-alert">
                    ⚠️ @ViewBag.ErrorMessage
                </div>
            }

        </form>

        <div class="text-center mt-4 small text-muted">
            Forgot Password?
            <a asp-controller="Registration"
               asp-action="Create"
               class="text-dark fw-semibold">Reset</a>
        </div>

    </div>

    <script>
            function togglePw() {
                const input = document.getElementById('passwordInput');
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>
</html>