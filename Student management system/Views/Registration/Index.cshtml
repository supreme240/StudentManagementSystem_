@model IEnumerable<RegistrationViewModel>

@{
    ViewData["Title"] = "Registration List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Student Registration List</h2>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success">
                Add New Registration
            </a>

            <a asp-action="Logout" class="btn btn-danger">
                Logout
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Date of Birth</th>
                <th>Address</th>
                <th>Gender</th>
                <th>Course</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.DateOfBirth.ToString("dd-MM-yyyy")</td>
                    <td>@item.Address</td>
                    <td>@item.Gender</td>
                    <td>@item.Course</td>
                    <td>
                        <!-- Edit Button -->
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">Edit</a>

                        <!-- Delete Button with Confirmation (HTML Form) -->
                        <form asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this record? This action cannot be undone.')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>