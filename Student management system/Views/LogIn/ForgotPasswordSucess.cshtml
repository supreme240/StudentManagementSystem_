@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful — Student Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f4f6f9;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 100%;
                max-width: 380px;
                background: #ffffff;
                border-radius: 16px;
                padding: 36px 32px;
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            }

            .btn-login {
                background: #212529;
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: 11px;
                font-size: 15px;
                font-weight: 500;
                width: 100%;
                transition: opacity .15s;
                margin-top: 4px;
                text-decoration: none;
                display: block;
                text-align: center;
            }

                .btn-login:hover {
                    opacity: .82;
                    color: #fff;
                }
    </style>
</head>
<body>

    <div class="login-card text-center">

        <div style="font-size:42px; margin-bottom:12px;">✅</div>
        <h5 class="fw-bold mb-1">Password Reset Successful</h5>
        <p class="text-muted small mb-4">Your password has been updated. You can now log in with your new password.</p>

        <a href="/LogIn/LogIn" class="btn-login">Go to Login</a>

    </div>

</body>
</html>

